{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dome",
  "main": "./dist/_worker.js/index.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "thedomesessions.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
