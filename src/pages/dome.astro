---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialSections from '../components/EditorialSections.astro';
import Gallery from '../components/Gallery.astro';
import EndLink from '../components/EndLink.astro';
import { page, publicImage } from '../lib/content';
const dome = await page.dome();
---
<BaseLayout title={dome.seoTitle} description={dome.seoDescription} image={publicImage(dome.ogImage || dome.heroImage)} active="dome">
  <section class="hero secondary-hero"><img class="hero-image" src={publicImage(dome.heroImage)} alt={dome.heroAlt} fetchpriority="high" /><div class="hero-inner"><div class="eyebrow"><span>05</span><span>ARCHITECTURE / SOUND / MEMORY</span></div><h1>{dome.title}<span class="period">.</span></h1><div class="hero-bottom"><p>{dome.subtitle}</p></div></div></section>
  <EditorialSections sections={dome.sections} />
  <Gallery images={dome.gallery} heading="A place in fragments" label="DETAILS" />
  <EndLink href="/heritage/" kicker="DISCOVER THE LARGER SITE" title="THE HERITAGE SITE" />
</BaseLayout>
