---
import BaseLayout from '../layouts/BaseLayout.astro';
import { page, renderMarkdoc, publicImage } from '../lib/content';
const team = await page.team();
---
<BaseLayout title={team.seoTitle} description={team.seoDescription} image={publicImage(team.ogImage || team.members?.[0]?.portrait)} active="team">
  <section class="page-title standalone"><div class="eyebrow"><span>03</span><span>THE PEOPLE</span></div><h1>{team.title}<span class="period">.</span></h1><p>{team.subtitle}</p></section>
  <section class="people-grid">{team.members?.map((person) => <article class="person"><img src={publicImage(person.portrait)} alt={person.alt || `Portrait of ${person.name}`} loading="lazy" /><div class="person-info"><span class="micro">{person.role}</span><h2>{person.name}</h2>{person.shortBio && <p class="lead">{person.shortBio}</p>}<div class="rich-text" set:html={renderMarkdoc(person.biography)} /><div class="person-links">{person.website && <a href={person.website} target="_blank" rel="noopener noreferrer">Website ↗</a>}{person.instagram && <a href={person.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}{person.otherLinks && <p>{person.otherLinks}</p>}</div></div></article>)}</section>
</BaseLayout>
