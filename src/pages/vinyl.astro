---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Gallery from '../components/Gallery.astro';
import EndLink from '../components/EndLink.astro';
import { page, renderMarkdoc, publicImage } from '../lib/content';
const vinyl = await page.vinyl();
const candidatePlayer = vinyl.bandcampEmbedUrl || '';
const player = /^https:\/\/bandcamp\.com\/EmbeddedPlayer\/(?:album|track)=\d+\//.test(candidatePlayer) ? candidatePlayer : '';
---
<BaseLayout title={vinyl.seoTitle} description={vinyl.seoDescription} image={publicImage(vinyl.ogImage || vinyl.gallery?.[0]?.image)} active="vinyl">
  <section class="page-hero"><div class="page-title"><SectionIntro index="02" label="THE VINYL" /><h1>{vinyl.title}<span class="period">.</span></h1><p>{vinyl.subtitle}</p></div>{vinyl.gallery?.[0] && <img src={publicImage(vinyl.gallery[0].image)} alt={vinyl.gallery[0].alt} fetchpriority="high" />}</section>
  <section class="section"><SectionIntro index="01" label="THE RECORD" /><div class="editorial-grid"><h2>{vinyl.introHeading}</h2><div class="prose"><div class="lead rich-text" set:html={renderMarkdoc(vinyl.intro)} /><div class="rich-text" set:html={renderMarkdoc(vinyl.description)} /></div></div></section>
  <section class="section listening-section"><SectionIntro index="02" label="LISTEN & ORDER" /><div class="editorial-grid"><div><h2>Listen to<br /><em>the sessions.</em></h2><p>Stream the album or explore the physical release on Bandcamp.</p><a class="outline-button" href={vinyl.purchaseUrl || vinyl.bandcampUrl} target="_blank" rel="noopener noreferrer">VIEW ON BANDCAMP ↗</a></div><div class="bandcamp-wrap"><iframe title="The Dome Sessions on Bandcamp" style="border:0;width:100%;height:472px" src={player} seamless loading="lazy"><a href={vinyl.bandcampUrl}>The Dome Sessions</a></iframe></div></div></section>
  {vinyl.trackListing?.length > 0 && <section class="section"><SectionIntro index="03" label="TRACK LISTING" /><ol>{vinyl.trackListing.map((track) => <li>{track}</li>)}</ol></section>}
  <Gallery images={vinyl.gallery} heading="The record in images" label="THE OBJECT" />
  <EndLink href="/dome/" kicker="EXPLORE THE SPACE" title="THE DOME" />
</BaseLayout>
