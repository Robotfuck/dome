---
import { publicImage } from '../lib/content';
const { image, alt = '', eyebrow = '', title, subtitle = '', cta = '' } = Astro.props;
---
<section class="hero">
  <img class="hero-image" src={publicImage(image)} alt={alt} fetchpriority="high" />
  <div class="hero-inner">
    {eyebrow && <div class="hero-overline">{eyebrow}</div>}
    <h1>{title}</h1>
    <div class="hero-bottom"><p>{subtitle}</p>{cta && <a class="text-link" href="#trailer">{cta} <span>↘</span></a>}</div>
  </div>
  <div class="vertical-label" aria-hidden="true">SCROLL TO EXPLORE &nbsp; ↓</div>
</section>
